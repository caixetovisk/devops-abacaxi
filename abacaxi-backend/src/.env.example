# Porta da API
PORT=3001

# Endereço do frontend (liberado no CORS). Em produção, use a URL do site no Render.
FRONTEND_URL=http://localhost:5173

# Chave usada para assinar os tokens de login (troque por um texto longo e aleatório)
JWT_SECRET=troque-esta-chave

# Usuário administrador criado automaticamente na primeira execução
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ---------- Banco LOCAL (MySQL) ----------
# Usado quando DATABASE_URL estiver vazia
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fazenda_abacaxi
DB_USER=root
DB_PASSWORD=root

# ---------- Banco no RENDER (PostgreSQL) ----------
# Quando preenchida, a API usa PostgreSQL e ignora as variáveis DB_* acima.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Use DB_SSL=true somente se estiver usando a "External Database URL"
# DB_SSL=false
